APP_NAME="DuckTail API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
# Fuso do negócio: decide o "hoje" das regras de calendário (a data gravada numa visita, `VISITED.date`).
# Os timestamps continuam gravados em UTC.
BUSINESS_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Local: arquivo (storage/logs/laravel.log). Produção: `stderr` (vai para `docker compose logs`).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local: debug. Produção: info (ou warning), senão cada consulta lenta e aviso enche o disco/log do Docker.
LOG_LEVEL=debug
# Produção: uma linha JSON por log (request_id e user_id em `extra`), pronta para jq/Loki/CloudWatch.
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
# Alerta de erro: webhook compatível com Slack (Slack, Mattermost, Discord com `/slack` no fim da URL).
# Preenchido, todo log a partir de LOG_SLACK_LEVEL (padrão: error, ou seja, os 500) vira uma mensagem.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=error

# Mostra a mensagem da exceção em `data.message_error` nas respostas 500 (nunca em produção)
SHOW_ERROR_MESSAGE=false

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=duck_tail
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
# Quantas vezes uma transação do Postgres é repetida em deadlock/serialização antes de responder 409
DB_TRANSACTION_ATTEMPTS=3
# Espera máxima por um lock (55P03 → 409) e duração máxima de uma consulta (cancelada → 500). `0` desliga.
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=30s
# Porta do Postgres exposta no host (ferramentas de banco e setup do e2e do web)
FORWARD_DB_PORT=5432

# Neo4j (grafo de lugares, cidades, temas, empresas, visitas e roteiros). Bolt pela rede do Docker.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ducktail_password
# Quantas vezes uma transação de escrita no grafo é repetida em erro transitório (deadlock do Neo4j)
NEO4J_TRANSACTION_ATTEMPTS=3
# Neo4j dos testes (container `neo4j-testing`, sem volume): os testes nunca tocam o grafo acima.
NEO4J_TESTING_URI=bolt://neo4j-testing:7687
# Portas do Neo4j no host (Neo4j Browser em http://localhost:7474)
FORWARD_NEO4J_HTTP_PORT=7474
FORWARD_NEO4J_BOLT_PORT=7687
# Produção: memória do Neo4j (heap e page cache)
NEO4J_HEAP_SIZE=512m
NEO4J_PAGECACHE_SIZE=512m

# Importação do Wikidata (`php artisan ducktail:import`): endpoint SPARQL e User-Agent (a política do
# Wikidata pede um User-Agent que identifique o cliente).
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIDATA_USER_AGENT="DuckTailImporter/1.0 (portfolio project)"

# GraphQL (/graphql): introspecção desligada em produção (o web gera os tipos a partir de graphql/schema.graphql)
GRAPHQL_INTROSPECTION=true

# A API é stateless (tokens opacos no header Authorization: Bearer): sessão e fila não são usadas
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sessão (tokens opacos: access no header Authorization: Bearer, refresh no corpo do refresh)
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Seed — primeira conta de acesso (usada por `make db-seed`)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local: usuários de demonstração (ana@ducktail.local, bruno@ducktail.local) com visitas, para o web
# mostrar "amigos que já foram" e recomendações. Ignorado em produção.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# Proxies confiáveis para X-Forwarded-For (o IP do cliente é a chave do rate limit).
# Padrão: redes privadas (rede Docker do web e do Nginx Proxy Manager). Nunca use `*`.
TRUSTED_PROXIES=PRIVATE_SUBNETS

# Backups (`make backup`, também rodado pelo `make deploy`): quantos dumps manter em backups/ e para
# onde copiar fora deste disco (destino do rsync: outro disco montado ou usuario@host:/caminho/).
BACKUP_KEEP=14
BACKUP_OFFSITE=

# Docker
DOCKER_COMPOSE_FILE=docker-compose.local.yml
# Local — porta da API no host (em produção não há porta publicada)
NGINX_PORT=8080
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
# Produção — rede Docker do Nginx Proxy Manager (o nginx da API entra nela)
PROXY_NETWORK=nginx-proxy-manager
